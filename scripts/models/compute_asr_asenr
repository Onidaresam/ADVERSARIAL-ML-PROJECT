import os
import numpy as np
import pandas as pd

# ============================================================
# CONFIG
# ============================================================
SEGMENT_ID = "01"
BASE = "/content/drive/MyDrive/ADVERSARIAL_ML_PROJECT"
SEG_FOLDER = f"{BASE}/data/segments_time/segment_{SEGMENT_ID}"
TEST_SPLIT_FOLDER = f"{SEG_FOLDER}/models_reducedscope/testsplits_logreg_research"
BIN_INFO_FOLDER = f"{SEG_FOLDER}/models_reducedscope/bin_info"

variable_bins = np.load(f"{BIN_INFO_FOLDER}/variable_bins.npy").astype(int)
constant_zero_bins = np.load(f"{BIN_INFO_FOLDER}/constant_zero_bins.npy").astype(int)
constant_one_bins = np.load(f"{BIN_INFO_FOLDER}/constant_one_bins.npy").astype(int)

# ============================================================
# LOADING HELPERS
# ============================================================
def load_phase_arrays(model_name, phase, attack=None, pct=None):
    if phase == "clean":
        prefix = f"seg{SEGMENT_ID}_{model_name}_clean"
    else:
        prefix = f"seg{SEGMENT_ID}_{model_name}_{phase}_{attack}_{pct}"

    full_pred = np.load(f"{TEST_SPLIT_FOLDER}/{prefix}_full_pred.npy")
    y_full = np.load(f"{TEST_SPLIT_FOLDER}/{prefix}_ytest_full.npy")
    poison_flags = np.load(f"{TEST_SPLIT_FOLDER}/{prefix}_poison_flags.npy")
    return full_pred, y_full, poison_flags

# ============================================================
# METRIC COMPUTATION
# ============================================================
def compute_asr_label_flip(y_clean, y_poison, pred_poison):
    flipped = (y_clean != y_poison)
    if flipped.sum() == 0:
        return 0.0
    success = (pred_poison == y_poison) & flipped
    return success.sum() / flipped.sum()

def compute_asr_sensory(pred_clean, pred_poison, poisoned_mask):
    if poisoned_mask.sum() == 0:
        return 0.0
    changed = (pred_clean != pred_poison) & poisoned_mask
    return changed.sum() / poisoned_mask.sum()

def compute_asenr(pred_clean, pred_poison, poisoned_mask):
    clean_positions = ~poisoned_mask
    if clean_positions.sum() == 0:
        return 0.0
    changed = (pred_clean != pred_poison) & clean_positions
    return changed.sum() / clean_positions.sum()

# ============================================================
# UNIFIED FILE-BASED METRIC COMPUTATION
# ============================================================
def compute_asr_asenr_for_files(model, phase, attack, pct,
                                full_pred_path, ytest_path, poison_flags_path,
                                pred_clean=None, y_clean=None):
    full_pred = np.load(full_pred_path)
    y_true = np.load(ytest_path)
    poison_flags = np.load(poison_flags_path)

    if attack == "label_flip":
        flipped = (y_clean != y_true)
        if flipped.sum() == 0:
            asr = 0.0
        else:
            success = (full_pred == y_true) & flipped
            asr = success.sum() / flipped.sum()
        poisoned_mask = flipped

    else:  # sensory
        poisoned_mask = poison_flags.astype(bool)
        if poisoned_mask.sum() == 0:
            asr = 0.0
        else:
            changed = (pred_clean != full_pred) & poisoned_mask
            asr = changed.sum() / poisoned_mask.sum()

    clean_positions = ~poisoned_mask
    if clean_positions.sum() == 0:
        asenr = 0.0
    else:
        changed_clean = (pred_clean != full_pred) & clean_positions
        asenr = changed_clean.sum() / clean_positions.sum()

    return {
        "model": model,
        "phase": phase,
        "attack": attack,
        "pct": pct,
        "ASR": asr,
        "ASenR": asenr,
    }

# ============================================================
# MAIN EXECUTION
# ============================================================
def main():
    models = ["lr", "mlp", "xgb", "cat"]
    attacks = ["label_flip", "sensory_add1"]
    pcts = ["0_5", "1", "5", "10", "20"]
    phases = ["robust", "advtrain"]

    results = []

    for model in models:
        # Load clean baseline once per model
        pred_clean, y_clean, _ = load_phase_arrays(model, "clean")

        for attack in attacks:
            for pct in pcts:
                for phase in phases:

                    prefix = f"seg{SEGMENT_ID}_{model}_{phase}_{attack}_{pct}"

                    full_pred_path = os.path.join(TEST_SPLIT_FOLDER, f"{prefix}_full_pred.npy")
                    ytest_path = os.path.join(TEST_SPLIT_FOLDER, f"{prefix}_ytest_full.npy")
                    poison_flags_path = os.path.join(TEST_SPLIT_FOLDER, f"{prefix}_poison_flags.npy")

                    if not (os.path.exists(full_pred_path)
                            and os.path.exists(ytest_path)
                            and os.path.exists(poison_flags_path)):
                        print(f"[SKIP] Missing files for {model} {phase} {attack} {pct}")
                        continue

                    res = compute_asr_asenr_for_files(
                        model, phase, attack, pct,
                        full_pred_path, ytest_path, poison_flags_path,
                        pred_clean=pred_clean,
                        y_clean=y_clean
                    )
                    results.append(res)

    df = pd.DataFrame(results)
    out_csv = os.path.join(TEST_SPLIT_FOLDER, "asr_asenr_all_models.csv")
    df.to_csv(out_csv, index=False)
    print("Saved:", out_csv)


if __name__ == "__main__":
    main()
